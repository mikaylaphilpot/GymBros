PORT=5001
NODE_ENV=development
PUBLIC_API_URL=http://localhost:5001
MONGODB_URI=
FCM_ENABLED=false
# Set this only on the backend host when FCM_ENABLED=true. Never commit the JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
MONGODB_DB=gymbros
JWT_SECRET=replace-with-a-local-secret
ALLOW_DEV_USER_HEADER=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
